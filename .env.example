PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Security
JWT_SECRET=super_secret_jwt_key_kisanmitra_2025_secure
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
ADMIN_INITIAL_SECRET=admin123

# SMS Gateway Configuration (India & Global)
# Option 1: Fast2SMS (India) - Get free API key from https://www.fast2sms.com
FAST2SMS_API_KEY=

# Option 2: Twilio (Global/India) - Get from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 3: Custom SMS Webhook URL
SMS_GATEWAY_URL=
