{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "js/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
